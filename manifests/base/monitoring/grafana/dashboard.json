{
  "title": "Snapshot — Service Health",
  "timezone": "utc",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(shortlink_api_http_requests_total[5m])) by (route)", "legendFormat": "shortlink-api {{route}}" },
        { "expr": "sum(rate(analytics_worker_http_requests_total[5m])) by (route)", "legendFormat": "analytics-worker {{route}}" }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(shortlink_api_http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "shortlink-api {{route}}" },
        { "expr": "histogram_quantile(0.95, sum(rate(analytics_worker_http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "analytics-worker {{route}}" }
      ]
    },
    {
      "id": 3,
      "title": "Error rate (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(shortlink_api_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(shortlink_api_http_requests_total[5m]))",
          "legendFormat": "shortlink-api"
        },
        {
          "expr": "sum(rate(analytics_worker_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(analytics_worker_http_requests_total[5m]))",
          "legendFormat": "analytics-worker"
        }
      ]
    },
    {
      "id": 4,
      "title": "Click queue depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "shortlink_api_click_queue_depth", "legendFormat": "producer side (redis stream length)" },
        { "expr": "analytics_worker_click_queue_depth", "legendFormat": "consumer group pending" }
      ]
    },
    {
      "id": 5,
      "title": "Events processed, by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(analytics_worker_events_processed_total[5m])) by (outcome)", "legendFormat": "{{outcome}}" }
      ]
    }
  ]
}
